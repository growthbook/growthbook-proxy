#!/usr/local/bin/node
// yarn/pnpm shim for the shell-less distroless image, which ships neither - keeps `start:with-tracing` CMD overrides working.
const path = require("node:path");

const cmd = process.argv[2];
if (cmd !== "start" && cmd !== "start:with-tracing") {
  console.error(
    `start-shim: "${cmd}" is not supported on this image (only start / start:with-tracing are)`,
  );
  process.exit(1);
}

// Load tracing before application dependencies, just like `node --require`.
if (cmd === "start:with-tracing") {
  require(path.resolve("dist/tracing.js"));
}

// Stay in the container's main process so signals reach the application's
// shutdown handlers directly, without a shell or process manager.
require(path.resolve("dist/index.js"));
