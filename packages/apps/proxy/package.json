{
  "name": "@growthbook/proxy",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "description": "GrowthBook proxy server for caching, realtime updates, remote evaluation, etc",
  "version": "1.3.4",
  "main": "dist/app.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/growthbook/growthbook-proxy",
    "directory": "packages/apps/proxy"
  },
  "author": "Bryce Fitzsimons",
  "scripts": {
    "build:clean": "rimraf -rf dist tsconfig.tsbuildinfo",
    "build:typescript": "tsc",
    "build": "pnpm build:clean && pnpm build:typescript",
    "type-check": "tsc --pretty --noEmit",
    "start": "node dist/index.js",
    "start:with-tracing": "node --require ./dist/tracing.js dist/index.js",
    "dev": "concurrently 'tsc --watch' 'nodemon -q dist/index.js | pnpm pino-pretty'"
  },
  "dependencies": {
    "@growthbook/growthbook": "^1.6.5",
    "pm2": "^6.0.14",
    "@growthbook/proxy-eval": "1.1.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.218.0",
    "@opentelemetry/sdk-metrics": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.4.1",
    "mongodb": "^6.9.0",
    "pino-http": "^10.3.0",
    "spdy": "^4.0.2",
    "uuid": "^11.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.1",
    "@types/node": "^22.0.0",
    "@types/pino": "^7.0.5",
    "@types/spdy": "^3.4.9",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.7",
    "pino-pretty": "^11.3.0",
    "rimraf": "^6.0.1",
    "typescript": "5.8.2"
  }
}
